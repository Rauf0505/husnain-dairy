{% doc %}
  @prompt
    Create a responsive announcement bar section for my Shopify Dawn theme with these features:
    
    - Let me add, edit, remove, and reorder multiple announcements in the theme editor using announcement blocks.
    - Make the messages scroll continuously in a seamless loop, with no empty gaps. Repeat the messages in the rendered ticker as needed; don’t require me to enter them twice.
    - Give me editable background color, text color, and scroll speed settings.
    - Support an optional link for each announcement.
    - In the theme editor preview, keep the ticker still and make each announcement block easy to select and edit.
    - Respect reduced-motion preferences and pause the ticker on hover or keyboard focus.
    - Make it available in the header group and as a homepage section, so I can place another ticker after the hero.
    - Keep the design slim and simple. Use Dawn-compatible Liquid, CSS, and JavaScript, and don’t hard-code the colors or announcement text.
{% enddoc %}
{% assign ticker_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .announcement-ticker-{{ ticker_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; overflow: hidden; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; }
  .announcement-ticker-{{ ticker_id }}__viewport { width: 100%; overflow: hidden; }
  .announcement-ticker-{{ ticker_id }}__track { display: flex; width: max-content; animation: announcement-ticker-scroll-{{ ticker_id }} {{ block.settings.scroll_speed }}s linear infinite; }
  .announcement-ticker-{{ ticker_id }}__group { display: flex; flex: 0 0 max-content; min-width: 100vw; align-items: center; justify-content: space-around; }
  .announcement-ticker-{{ ticker_id }}__item { display: flex; flex: 0 0 auto; align-items: center; min-height: 36px; padding: 8px 24px; color: inherit; font-size: 13px; line-height: 1.4; text-align: center; text-decoration: none; white-space: nowrap; }
  .announcement-ticker-{{ ticker_id }}__item:focus-visible { outline: 2px solid currentColor; outline-offset: -3px; }
  .announcement-ticker-{{ ticker_id }}:hover .announcement-ticker-{{ ticker_id }}__track, .announcement-ticker-{{ ticker_id }}:focus-within .announcement-ticker-{{ ticker_id }}__track { animation-play-state: paused; }
  @keyframes announcement-ticker-scroll-{{ ticker_id }} { to { transform: translateX(-25%); } }
  @media (prefers-reduced-motion: reduce) { .announcement-ticker-{{ ticker_id }}__track { animation: none; } .announcement-ticker-{{ ticker_id }}__group:not(:first-child) { display: none; } .announcement-ticker-{{ ticker_id }}__group:first-child { flex-wrap: wrap; justify-content: center; } }
  .shopify-design-mode .announcement-ticker-{{ ticker_id }}__track { animation: none; }
  .shopify-design-mode .announcement-ticker-{{ ticker_id }}__group:not(:first-child) { display: none; }
  .shopify-design-mode .announcement-ticker-{{ ticker_id }}__group:first-child { flex-wrap: wrap; justify-content: center; }
  @media screen and (max-width: 749px) { .announcement-ticker-{{ ticker_id }}__item { min-height: 34px; padding: 7px 16px; font-size: 12px; } }
{% endstyle %}
{% capture announcement_items %}
  {% for i in (1..5) %}
    {% assign message_key = 'message_' | append: i %}
    {% assign link_key = 'link_' | append: i %}
    {% assign message = block.settings[message_key] %}
    {% assign item_link = block.settings[link_key] %}
    {% if message != blank %}
      {% if item_link != blank %}<a class="announcement-ticker-{{ ticker_id }}__item" href="{{ item_link }}">{{ message | escape }}</a>{% else %}<span class="announcement-ticker-{{ ticker_id }}__item">{{ message | escape }}</span>{% endif %}
    {% endif %}
  {% endfor %}
{% endcapture %}
{% if announcement_items != blank %}
  <div class="announcement-ticker-{{ ticker_id }}" {{ block.shopify_attributes }}>
    <div class="announcement-ticker-{{ ticker_id }}__viewport" aria-label="Store announcements">
      <div class="announcement-ticker-{{ ticker_id }}__track">
        {% for copy in (1..4) %}<div class="announcement-ticker-{{ ticker_id }}__group" {% if copy > 1 %}aria-hidden="true"{% endif %}>{{ announcement_items }}</div>{% endfor %}
      </div>
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "Announcement ticker",
  "tag": null,
  "class": "announcement-ticker",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#5d250f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "range", "id": "scroll_speed", "label": "Scroll speed", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 30 },
    { "type": "header", "content": "Announcements" },
    { "type": "text", "id": "message_1", "label": "Message 1", "default": "Welcome to our store" },
    { "type": "url", "id": "link_1", "label": "Link 1" },
    { "type": "text", "id": "message_2", "label": "Message 2", "default": "Discover our latest products" },
    { "type": "url", "id": "link_2", "label": "Link 2" },
    { "type": "text", "id": "message_3", "label": "Message 3" },
    { "type": "url", "id": "link_3", "label": "Link 3" },
    { "type": "text", "id": "message_4", "label": "Message 4" },
    { "type": "url", "id": "link_4", "label": "Link 4" },
    { "type": "text", "id": "message_5", "label": "Message 5" },
    { "type": "url", "id": "link_5", "label": "Link 5" }
  ],
  "presets": [{ "name": "Announcement ticker" }]
}
{% endschema %}