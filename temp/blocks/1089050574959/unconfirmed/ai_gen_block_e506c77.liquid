{% doc %}
  @prompt
    Create a responsive announcement bar section for my Shopify Dawn theme with these features:
    
    - Let me add, edit, remove, and reorder multiple announcements in the theme editor using announcement blocks.
    - Make the messages scroll continuously in a seamless loop, with no empty gaps. Repeat the messages in the rendered ticker as needed; don’t require me to enter them twice.
    - Give me editable background color, text color, and scroll speed settings.
    - Support an optional link for each announcement.
    - In the theme editor preview, keep the ticker still and make each announcement block easy to select and edit.
    - Respect reduced-motion preferences and pause the ticker on hover or keyboard focus.
    - Make it available in the header group and as a homepage section, so I can place another ticker after the hero.
    - Keep the design slim and simple. Use Dawn-compatible Liquid, CSS, and JavaScript, and don’t hard-code the colors or announcement text., they are not scrolling and there is no loop duration it is endless continues for ever nowhere it end
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-announcement-ticker-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; overflow:hidden; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; font-family:{{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}; }
  .ai-announcement-ticker-{{ ai_gen_id }} .ai-announcement-ticker__viewport { overflow:hidden; min-height:36px; display:flex; align-items:center; }
  .ai-announcement-ticker-{{ ai_gen_id }} .ai-announcement-ticker__track { display:flex; align-items:center; width:max-content; }
  .ai-announcement-ticker-{{ ai_gen_id }} .ai-announcement-ticker__group { display:flex; align-items:center; flex:0 0 auto; width:max-content; }
  .ai-announcement-ticker-{{ ai_gen_id }} .ai-announcement-ticker__item { display:inline-flex; align-items:center; justify-content:center; flex:0 0 auto; min-height:36px; padding:7px 30px; color:inherit; text-decoration:none; font-size:13px; line-height:1.4; white-space:nowrap; }
  .ai-announcement-ticker-{{ ai_gen_id }} a.ai-announcement-ticker__item:hover { text-decoration:underline; }
  .ai-announcement-ticker-{{ ai_gen_id }} a.ai-announcement-ticker__item:focus-visible { outline:2px solid currentColor; outline-offset:-3px; }
  .ai-announcement-ticker-{{ ai_gen_id }}[data-editor="false"] .ai-announcement-ticker__track { animation:ai-announcement-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite; }
  .ai-announcement-ticker-{{ ai_gen_id }}:hover .ai-announcement-ticker__track, .ai-announcement-ticker-{{ ai_gen_id }}:focus-within .ai-announcement-ticker__track { animation-play-state:paused; }
  @keyframes ai-announcement-scroll-{{ ai_gen_id }} { from { transform:translateX(0); } to { transform:translateX(-50%); } }
  @media (prefers-reduced-motion:reduce) { .ai-announcement-ticker-{{ ai_gen_id }} .ai-announcement-ticker__track { animation:none !important; } }
{% endstyle %}
<announcement-ticker-{{ ai_gen_id }} class="ai-announcement-ticker-{{ ai_gen_id }}" data-editor="{% if request.design_mode %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-ticker__viewport"><div class="ai-announcement-ticker__track">
    {% for copy in (1..2) %}<div class="ai-announcement-ticker__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
      {% for i in (1..3) %}{% assign message_key = 'message_' | append: i %}{% assign link_key = 'link_' | append: i %}{% assign message = block.settings[message_key] %}{% assign link = block.settings[link_key] %}{% if message != blank %}{% if link != blank and copy == 1 %}<a class="ai-announcement-ticker__item" href="{{ link }}">{{ message | escape }}</a>{% else %}<span class="ai-announcement-ticker__item">{{ message | escape }}</span>{% endif %}{% endif %}{% endfor %}
    </div>{% endfor %}
  </div></div>
</announcement-ticker-{{ ai_gen_id }}>
<script>
(function(){var tag='announcement-ticker-{{ ai_gen_id }}';if(customElements.get(tag))return;class AnnouncementTicker extends HTMLElement{connectedCallback(){if(this.dataset.editor==='true'||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;var viewport=this.querySelector('.ai-announcement-ticker__viewport');var groups=this.querySelectorAll('.ai-announcement-ticker__group');if(!viewport||groups.length!==2)return;groups.forEach(function(group){var original=Array.from(group.children);if(!original.length)return;var limit=0;while(group.scrollWidth<=viewport.clientWidth&&limit<100){original.forEach(function(item){group.appendChild(item.cloneNode(true));});limit++;}});}}customElements.define(tag,AnnouncementTicker);})();
</script>
{% schema %}
{"name":"Announcement ticker","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"background_color","label":"Background","default":"#5d250f"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"range","id":"scroll_speed","label":"Loop duration","min":10,"max":60,"step":5,"unit":"s","default":30},{"type":"header","content":"Announcement one"},{"type":"text","id":"message_1","label":"Message","default":"Welcome to our store"},{"type":"url","id":"link_1","label":"Link"},{"type":"header","content":"Announcement two"},{"type":"text","id":"message_2","label":"Message","default":"Explore our latest products"},{"type":"url","id":"link_2","label":"Link"},{"type":"header","content":"Announcement three"},{"type":"text","id":"message_3","label":"Message","default":"Shop online today"},{"type":"url","id":"link_3","label":"Link"}],"presets":[{"name":"Announcement ticker"}],"tag":null,"class":"announcement-ticker-block"}
{% endschema %}