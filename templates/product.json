n          <span class=\"badge\">WhatsApp</span>\n          <div class=\"stars\">★★★★★</div>\n          <div class=\"review-text\">${review.text}</div>\n          <img src=\"${review.img}\" class=\"review-img\" loading=\"lazy\">\n        `;\n        grid.appendChild(card);\n      });\n      showCards();\n    }\n\n    function showCards() {\n      const cards = document.querySelectorAll('.review-card');\n      for (let i = 0; i < cards.length; i++) {\n        if (i < currentVisible) {\n          cards[i].style.display = 'flex';\n        } else {\n          cards[i].style.display = 'none';\n        }\n      }\n      if (currentVisible >= cards.length) {\n        button.style.display = 'none';\n      }\n    }\n\n    renderCards();\n\n    button.addEventListener('click', function() {\n      currentVisible += step;\n      showCards();\n    });\n  });\n</script>","color_scheme":"","padding_top":40,"padding_bottom":52}},"1783792863eac8444a":{"type":"apps","blocks":{"trustwill_trustoo_review_widget_bWE3CV":{"type":"shopify://apps/trustwill-trustoo/blocks/review-widget/c8f15077-6475-4e86-ad06-b66038d5ba2c","settings":{"product":""}}},"block_order":["trustwill_trustoo_review_widget_bWE3CV"],"settings":{"include_margins":true}},"custom_liquid_GmAMTq":{"type":"custom-liquid","name":"FAQs","settings":{"custom_liquid":"<style>\n  .premium-faq {\n    max-width: 900px;\n    margin: 20px auto;\n    padding: 0 18px;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    letter-spacing: -0.2px;\n  }\n\n  .premium-faq-heading {\n    font-size: 32px;\n    font-weight: 700;\n    color: #5d250f;\n    margin-bottom: 8px;\n    line-height: 1.2;\n    text-align: center;\n  }\n\n  .premium-faq-subtitle {\n    font-size: 16px;\n    color: #666;\n    margin-bottom: 30px;\n    text-align: center;\n  }\n\n  .premium-faq-box {\n    border: 1px solid #f5ebe6;\n    border-radius: 16px;\n    overflow: hidden;\n    background: #fff;\n    box-shadow: 0px 4px 20px rgba(93, 37, 15, 0.04);\n  }\n\n  .premium-faq-item {\n    border-bottom: 1px solid #f5ebe6;\n    transition: background-color 0.3s ease;\n  }\n\n  .premium-faq-item:last-child {\n    border-bottom: none;\n  }\n\n  .premium-faq-item.active {\n    background-color: #faf6f4;\n  }\n\n  .premium-faq-question {\n    width: 100%;\n    background: transparent;\n    border: none;\n    padding: 24px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    cursor: pointer;\n    text-align: left;\n    font-family: inherit;\n  }\n\n  .premium-faq-title {\n    font-size: 17px;\n    font-weight: 600;\n    color: #333;\n    line-height: 1.4;\n    padding-right: 15px;\n  }\n\n  .premium-faq-item.active .premium-faq-title {\n    color: #5d250f;\n  }\n\n  .premium-faq-icon {\n    width: 28px;\n    height: 28px;\n    border-radius: 50%;\n    background: #fdfaf9;\n    border: 1px solid #eade987a;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n    color: #5d250f;\n    transition: 0.3s ease;\n    flex-shrink: 0;\n  }\n\n  .premium-faq-item.active .premium-faq-icon {\n    background: #5d250f;\n    color: #fff;\n    border-color: #5d250f;\n  }\n\n  .premium-faq-answer {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .premium-faq-answer-inner {\n    padding: 0 24px 24px;\n    color: #444;\n    font-size: 15px;\n    line-height: 1.6;\n  }\n  \n  .premium-faq-warning {\n    display: block;\n    margin-top: 10px;\n    background: #fff3cd;\n    color: #856404;\n    padding: 10px 14px;\n    border-radius: 8px;\n    font-size: 14px;\n    border-left: 4px solid #ffeeba;\n  }\n\n  @media(max-width: 768px){\n    .premium-faq {\n      padding: 0 14px;\n      margin: 30px auto;\n    }\n\n    .premium-faq-heading {\n      font-size: 26px;\n    }\n\n    .premium-faq-subtitle {\n      font-size: 14px;\n      margin-bottom: 20px;\n    }\n\n    .premium-faq-question {\n      padding: 20px 16px;\n    }\n\n    .premium-faq-title {\n      font-size: 15px;\n    }\n\n    .premium-faq-answer-inner {\n      padding: 0 16px 20px;\n      font-size: 14px;\n    }\n  }\n</style>\n\n<div class=\"premium-faq\">\n  <h2 class=\"premium-faq-heading\">Frequently Asked Questions</h2>\n  <div class=\"premium-faq-subtitle\">Hamare Pure Desi Ghee Ke Mutalik Aam Tor Par Pooche Jane Wale Sawalat</div>\n\n  <div class=\"premium-faq-box\">\n    <!-- FAQ 1 -->\n    <div class=\"premium-faq-item\">\n      <button class=\"premium-faq-question\" type=\"button\">\n        <span class=\"premium-faq-title\">Dono mein se best ghee kaunsa hota hai, Cow ya Buffalo?</span>\n        <span class=\"premium-faq-icon\">+</span>\n      </button>\n      <div class=\"premium-faq-answer\">\n        <div class=\"premium-faq-answer-inner\">\n          Ji, Cow Ghee hamara sabse zyada sell hone wala item hai aur yehi 90% logon ke liye har tarah se suitable aur faide-mand hota hai.\n        </div>\n      </div>\n    </div>\n\n    <!-- FAQ 2 -->\n    <div class=\"premium-faq-item\">\n      <button class=\"premium-faq-question\" type=\"button\">\n        <span class=\"premium-faq-title\">Allow To Open ka kya matlab hai?</span>\n        <span class=\"premium-faq-icon\">+</span>\n      </button>\n      <div class=\"premium-faq-answer\">\n        <div class=\"premium-faq-answer-inner\">\n          Allow To Open ka matlab hai ke jab delivery rider aapka parcel lekar aayega, toh aap parcel ko pehle open karke tasalli se check kar sakte hain. Agar pasand aaye toh parcel rakh lein aur payment kardein, warna check karne ke baad mauqe par hi return kar sakte hain.\n          <span class=\"premium-faq-warning\">\n            <strong>⚠️ Zaroori Note:</strong> Agar aapko Allow To Open parcel chahiye, toh order place karne ke baad hamari team ko WhatsApp par lazmi bata dein ke aapko check karke lena hai. Phir aapka parcel check-mark ke sath bheja jayega, warna aam tor par yeh sahulat rider nahi dete.\n          </span>\n        </div>\n      </div>\n    </div>\n\n    <!-- FAQ 3 -->\n    <div class=\"premium-faq-item\">\n      <button class=\"premium-faq-question\" type=\"button\">\n        <span class=\"premium-faq-title\">Agar ghee receive karne ke baad pasand nahi aaya toh kya return ho jayega?</span>\n        <span class=\"premium-faq-icon\">+</span>\n      </button>\n      <div class=\"premium-faq-answer\">\n        <div class=\"premium-faq-answer-inner\">\n          Ji bilkul, aapki payment hamare paas amanat hai. Agar aap order receive karne ke baad uski quality se satisfied nahi hain, toh aapne bas hamari team se contact karna hai. Agle hi din hamara delivery rider aapke ghar se khud aa kar parcel wapas lega aur aapko poora refund diya jayega. \n          <br><br>\n          Ham Alhamdulillah 1985 se Sahiwal mein kaam kar rahe hain. Hamari Hali Road par apni shop bhi hai jo aap jab chahein visit kar sakte hain. Pakistan ki Desi Ghee category mein ham pehla online brand hain jinki apni offline shop bhi mojood hai.\n        </div>\n      </div>\n    </div>\n\n    <!-- FAQ 4 -->\n    <div class=\"premium-faq-item\">\n      <button class=\"premium-faq-question\" type=\"button\">\n        <span class=\"premium-faq-title\">Why We Trust On You (Ham Aap Par Yakeen Kyun Karein)?</span>\n        <span class=\"premium-faq-icon\">+</span>\n      </button>\n      <div class=\"premium-faq-answer\">\n        <div class=\"premium-faq-answer-inner\">\n          Alhamdulillah, ham 1985 se Sahiwal mein kaam kar rahe hain. Ham Pakistan ke online desi ghee sellers mein pehla aisa brand hain jinki offline physical shop mojood hai (Location: Hali Road, Gol Chakkar, Sahiwal). \n          <br><br>\n          Iske sath-sath ham apne customers ko parcel open karke check karne ki sahulat dete hain aur uske baad bhi 14 days ki cashback guarantee dete hain ke agar ghee pasand na aaye toh wapsi mumkin hai. Hamare liye customer ki payment amanat hai kyunki Alhamdulillah hamein apni quality par poora proud hai.\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  document.querySelectorAll('.premium-faq-question').forEach(button => {\n    button.addEventListener('click', () => {\n      const item = button.parentElement;\n      const answer = item.querySelector('.premium-faq-answer');\n      const icon = button.querySelector('.premium-faq-icon');\n\n      document.querySelectorAll('.premium-faq-item').forEach(otherItem => {\n        if(otherItem !== item){\n          otherItem.classList.remove('active');\n          otherItem.querySelector('.premium-faq-answer').style.maxHeight = null;\n          otherItem.querySelector('.premium-faq-icon').textContent = '+';\n        }\n      });\n\n      item.classList.toggle('active');\n\n      if(item.classList.contains('active')){\n        answer.style.maxHeight = answer.scrollHeight + 'px';\n        icon.textContent = '−'; // Smooth minus icon\n      } else {\n        answer.style.maxHeight = null;\n        icon.textContent = '+';\n      }\n    });\n  });\n</script>","color_scheme":"","padding_top":40,"padding_bottom":52}},"related-products":{"type":"related-products","settings":{"heading":"You may also like","heading_size":"h2","products_to_show":4,"columns_desktop":4,"columns_mobile":"2","color_scheme":"scheme-1","image_ratio":"square","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"padding_top":36,"padding_bottom":28}}},"order":["main","disclosures","custom_liquid_NKddMW","1783792863eac8444a","custom_liquid_GmAMTq","related-products"]}