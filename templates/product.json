size: 14px;\n    line-height: 1.5;\n  }\n\n  .clean-tab-content-inner p {\n    margin: 0 0 10px 0;\n  }\n\n  .clean-tab-content-inner p:last-child {\n    margin-bottom: 0;\n  }\n\n  .warning-note {\n    margin-top: 10px;\n    background: #fff3cd;\n    color: #856404;\n    padding: 10px;\n    border-radius: 6px;\n    font-size: 13px;\n    border-left: 3px solid #ffeeba;\n  }\n\n  @media(max-width: 768px){\n    .clean-tab-header {\n      padding: 14px 16px;\n    }\n    .clean-tab-title {\n      font-size: 14px;\n    }\n    .clean-tab-content-inner {\n      font-size: 13px;\n      padding: 0 16px 16px 16px;\n    }\n  }\n</style>\n\n<div class=\"ghee-clean-accordion\">\n  \n  <!-- Tab 1: Description -->\n  {% if product.description != blank %}\n  <div class=\"clean-tab-item\">\n    <button class=\"clean-tab-header\" type=\"button\">\n      <span class=\"clean-tab-title\">Product Description</span>\n      <span class=\"clean-tab-icon\">+</span>\n    </button>\n    <div class=\"clean-tab-content\">\n      <div class=\"clean-tab-content-inner\">\n        {{ product.description }}\n      </div>\n    </div>\n  </div>\n  {% endif %}\n\n  <!-- Tab 2: Quality Guarantee -->\n  <div class=\"clean-tab-item\">\n    <button class=\"clean-tab-header\" type=\"button\">\n      <span class=\"clean-tab-title\">What's Quality Guarantee?</span>\n      <span class=\"clean-tab-icon\">+</span>\n    </button>\n    <div class=\"clean-tab-content\">\n      <div class=\"clean-tab-content-inner\">\n        The best option is to collect our product with our <strong>Allow To Open Policy</strong> (First check our Desi Ghee, then pay the amount). But after placing an order on the website, if you want Allow To Open, please inform our team on WhatsApp to mark your order as Allow To Open. Then you will get the Allow To Open facility.\n        <br><br>\n        If you receive our product and are not satisfied with it within 14 days, just contact us on our WhatsApp. The next day, our delivery rider will pick it up from your doorstep and we will refund you.\n      </div>\n    </div>\n  </div>\n\n  <!-- Tab 3: Allow To Open Policy -->\n  <div class=\"clean-tab-item\">\n    <button class=\"clean-tab-header\" type=\"button\">\n      <span class=\"clean-tab-title\">How's Allow To Open Policy Works</span>\n      <span class=\"clean-tab-icon\">+</span>\n    </button>\n    <div class=\"clean-tab-content\">\n      <div class=\"clean-tab-content-inner\">\n        Allow To Open Policy means when the delivery rider comes to your doorstep, you will taste our product. If you're satisfied, then pay the amount; otherwise, return it simply.\n        <div class=\"warning-note\">\n          <strong>Please Note:</strong> If you want Allow To Open, then after placing an order on our website, inform our team on WhatsApp. Then your order will be marked as Allow To Open; otherwise, not.\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Tab 4: FAQs -->\n  {% if pages.faqs.content != blank %}\n  <div class=\"clean-tab-item\">\n    <button class=\"clean-tab-header\" type=\"button\">\n      <span class=\"clean-tab-title\">Frequently Asked Questions</span>\n      <span class=\"clean-tab-icon\">+</span>\n    </button>\n    <div class=\"clean-tab-content\">\n      <div class=\"clean-tab-content-inner\">\n        {{ pages.faqs.content }}\n      </div>\n    </div>\n  </div>\n  {% endif %}\n\n</div>\n\n<script>\n  document.querySelectorAll('.clean-tab-header').forEach(button => {\n    button.addEventListener('click', () => {\n      const item = button.parentElement;\n      const content = item.querySelector('.clean-tab-content');\n      const icon = button.querySelector('.clean-tab-icon');\n\n      // Close other tabs smoothly\n      document.querySelectorAll('.clean-tab-item').forEach(otherItem => {\n        if(otherItem !== item){\n          otherItem.classList.remove('active');\n          otherItem.querySelector('.clean-tab-content').style.maxHeight = null;\n          otherItem.querySelector('.clean-tab-icon').textContent = '+';\n        }\n      });\n\n      // Toggle current tab\n      item.classList.toggle('active');\n\n      if(item.classList.contains('active')){\n        content.style.maxHeight = content.scrollHeight + 'px';\n        icon.textContent = '−'; // Changes to real minus symbol smoothly\n      } else {\n        content.style.maxHeight = null;\n        icon.textContent = '+';\n      }\n    });\n  });\n</script>"}}},"block_order":["title","custom_liquid_3FPP4G","price","variant_picker","buy_buttons","custom_liquid_gJy4KD","essential_estimated_app_block_deGnWL","custom_liquid_KMktaK"],"settings":{"enable_sticky_info":true,"color_scheme":"scheme-1","media_size":"medium","constrain_to_viewport":true,"media_fit":"cover","gallery_layout":"thumbnail_slider","mobile_thumbnails":"hide","media_position":"left","image_zoom":"lightbox","hide_variants":true,"enable_video_looping":false,"padding_top":36,"padding_bottom":12}},"disclosures":{"type":"disclosures","disabled":true,"settings":{"heading":"Disclosures","heading_size":"h2","open_by_default":false,"color_scheme":"","padding_top":36,"padding_bottom":0}},"custom_liquid_NKddMW":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  .reviews-wrapper {\n    text-align: center;\n    padding: 30px 10px;\n    max-width: 1200px;\n    margin: auto;\n  }\n\n  .reviews-title {\n    font-size: 28px;\n    font-weight: 700;\n    margin-bottom: 5px;\n    color: #5d250f;\n  }\n\n  .reviews-subtitle {\n    font-size: 16px;\n    color: #666;\n    margin-bottom: 30px;\n  }\n\n  .reviews-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 20px;\n  }\n\n  .review-card {\n    background: #fff;\n    border-radius: 14px;\n    padding: 18px;\n    box-shadow: 0px 4px 20px rgba(93, 37, 15, 0.05);\n    border: 1px solid #f5ebe6;\n    text-align: left;\n    display: none;\n    flex-direction: column;\n    justify-content: space-betwee