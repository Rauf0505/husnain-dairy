{{ 'announcement-ticker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'announcement-ticker.js' | asset_url }}" defer="defer"></script>

<announcement-ticker
  class="announcement-ticker"
  {{ section.shopify_attributes }}
  data-design-mode="{{ request.design_mode }}"
  style="--announcement-ticker-background: {{ section.settings.background_color }}; --announcement-ticker-foreground: {{ section.settings.text_color }}; --announcement-ticker-duration: {{ section.settings.speed }}s;"
  role="region"
  aria-label="Announcements"
>
  <div class="announcement-ticker__viewport">
    <div class="announcement-ticker__track">
      <div class="announcement-ticker__group" data-ticker-group>
        <div class="announcement-ticker__messages">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank or request.design_mode -%}
              <div class="announcement-ticker__item{% if block.settings.text == blank %} announcement-ticker__item--empty{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a class="announcement-ticker__link" href="{{ block.settings.link }}">
                    {{ block.settings.text | escape }}
                  </a>
                {%- elsif block.settings.text != blank -%}
                  <span>{{ block.settings.text | escape }}</span>
                {%- else -%}
                  <span class="announcement-ticker__placeholder">Enter announcement text</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</announcement-ticker>

{% schema %}
{
  "name": "Scrolling ticker",
  "max_blocks": 12,
  "class": "announcement-ticker-section",
  "enabled_on": {
    "groups": ["header"],
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Add, edit, or reorder announcement messages using the blocks below. Each ticker has its own messages, colors, and speed."
    },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#5D250F" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Time to scroll across",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over PKR 4,000" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling ticker",
      "blocks": [{ "type": "announcement" }, { "type": "announcement" }]
    }
  ]
}
{% endschema %}
